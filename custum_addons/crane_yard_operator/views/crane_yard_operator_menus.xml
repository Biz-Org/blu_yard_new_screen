              name="Pipe Picking &amp; Dropping"
              parent="menu_crane_yard_root"
              sequence="30"/>

    <menuitem id="menu_pipe_unstack"
              name="Unstack Upper Pipes"
              parent="menu_pipe_picking"
              action="action_pipe_unstack"
              sequence="10"/>

    <menuitem id="menu_pipe_drop"
              name="Pick &amp; Drop to Truck"
              parent="menu_pipe_picking"
              action="action_pipe_drop"
              sequence="20"/>

    <menuitem id="menu_pipe_return"
              name="Return Temporary Pipes"
              parent="menu_pipe_picking"
              action="action_pipe_return"
              sequence="30"/>
</odoo>

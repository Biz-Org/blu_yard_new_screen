<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="crane_yard_operator.PlatePutAwayTop">
        <div class="o_action o_cy h-100">
            <div class="o_cy_layout">
                <CraneYardNav active="navKey" disabled="state.busy"/>
                <div class="o_cy_content">
                    <div class="o_pt_page">

                        <header class="o_pt_header">
                            <div>
                                <div class="o_pt_breadcrumb">Yard <span class="mx-1">/</span> <span class="o_pt_breadcrumb_active">Plate Put Away – Top View</span></div>
                                <h1 class="o_pt_title">Plate Put Away – Top View</h1>
                                <div class="o_pt_subtitle">
                                    Top-view plates show Heat No., SO No., and allocated Bin. Colour = destination bin. Crane moves each plate into its bin.
                                </div>
                            </div>
                        </header>

                        <div class="o_pt_kpis">
                            <div class="o_pt_card o_pt_kpi">
                                <div class="o_pt_kpi_head"><span class="o_pt_kpi_label">Total Plates</span></div>
                                <div class="o_pt_kpi_value" t-esc="totalCount"/>
                            </div>
                            <div class="o_pt_card o_pt_kpi">
                                <div class="o_pt_kpi_head"><span class="o_pt_kpi_label">Pending</span></div>
                                <div class="o_pt_kpi_value o_pt_kpi_value--orange" t-esc="pendingCount"/>
                            </div>
                            <div class="o_pt_card o_pt_kpi">
                                <div class="o_pt_kpi_head"><span class="o_pt_kpi_label">In Bins</span></div>
                                <div class="o_pt_kpi_value o_pt_kpi_value--green" t-esc="placedCount"/>
                            </div>
                            <div class="o_pt_card o_pt_kpi">
                                <div class="o_pt_kpi_head"><span class="o_pt_kpi_label">Crane</span></div>
                                <div class="o_pt_kpi_value o_pt_kpi_value--crane" t-esc="craneStatus.title"/>
                                <div class="o_pt_kpi_sub" t-esc="craneStatus.text"/>
                            </div>
                        </div>

                        <div class="o_pt_legend">
                            <span class="o_pt_legend_title">Bin colours</span>
                            <span t-foreach="binLegend" t-as="bin" t-key="bin.code" class="o_pt_legend_item"
                                  t-att-style="'--pw-bin: ' + bin.color">
                                <span class="o_pt_legend_swatch"/>
                                <span t-esc="bin.label"/>
                            </span>
                        </div>

                        <div class="o_pt_body">
                            <div class="o_pt_main">
                                <section class="o_pt_card o_pt_yard_card">
                                    <div class="o_pt_card_head">
                                        <div>
                                            <h2 class="o_pt_card_title">Yard View – Plate Top</h2>
                                            <div class="o_pt_card_sub">Select a plate, then Confirm Put Away (or click its coloured bin). Crane throws it to the allocated location.</div>
                                        </div>
                                        <div t-if="selectedDetail" class="o_pt_selected_chip" t-att-style="selectedDetail.style">
                                            <strong t-esc="selectedDetail.heatNo"/>
                                            <span t-esc="selectedDetail.soNumber"/>
                                            <span class="o_pt_selected_bin" t-esc="selectedDetail.binLabel"/>
                                        </div>
                                    </div>

                                    <div class="o_pt_yard">
                                        <div class="o_pt_gantry">
                                            <div class="o_pt_rail"/>
                                            <div class="o_pt_trolley" t-attf-style="left: {{state.crane.x}}%">
                                                <div class="o_pt_trolley_body"><i class="fa fa-arrows-v"/> CRANE</div>
                                                <div class="o_pt_cable"/>
                                                <div t-if="craneLoadItem" class="o_pt_hook_load"
                                                     t-att-style="plateStyle(craneLoadItem)">
                                                    <span class="o_pt_hook_heat" t-esc="craneLoadItem.heatNo"/>
                                                    <span class="o_pt_bin_badge" t-esc="binBadge(craneLoadItem)"/>
                                                </div>
                                                <div t-else="" class="o_pt_hook"/>
                                            </div>
                                        </div>

                                        <div class="o_pt_wait_panel">
                                            <div class="o_pt_panel_label">Waiting plates (top view)</div>
                                            <div class="o_pt_plate_grid">
                                                <button t-foreach="pendingItems" t-as="item" t-key="item.id" type="button"
                                                        t-att-class="plateClass(item, 'wait')"
                                                        t-att-style="plateStyle(item)"
                                                        t-att-disabled="state.busy"
                                                        t-att-title="item.heatNo + ' · ' + item.soNumber + ' · Bin ' + item.targetBin"
                                                        t-on-click="() => this.selectItem(item)">
                                                    <span class="o_pt_bin_badge" t-esc="binBadge(item)"/>
                                                    <span class="o_pt_heat" t-esc="item.heatNo"/>
                                                    <span class="o_pt_so" t-esc="item.soNumber"/>
                                                    <span class="o_pt_meta"><t t-esc="item.id"/> · <t t-esc="item.size"/></span>
                                                </button>
                                                <div t-if="!pendingItems.length" class="o_pt_empty">No pending plates</div>
                                            </div>
                                        </div>

                                        <div class="o_pt_bins_panel">
                                            <div class="o_pt_bins_grid">
                                                <div t-foreach="bins" t-as="bin" t-key="bin.code"
                                                     t-attf-class="o_pt_bin_card {{bin.isTarget ? 'is-target' : ''}} {{bin.isLanding ? 'is-landing' : ''}}"
                                                     t-att-style="bin.style">
                                                    <div class="o_pt_bin_head">
                                                        <span class="o_pt_bin_swatch"/>
                                                        <span class="o_pt_bin_name" t-esc="bin.label"/>
                                                        <span class="o_pt_bin_count"><t t-esc="bin.items.length"/> stored</span>
                                                    </div>
                                                    <button type="button" class="o_pt_bin_rack"
                                                            t-att-disabled="state.busy or !bin.isTarget"
                                                            t-on-click="() => this.placeInBin(bin.code)">
                                                        <div t-foreach="bin.items" t-as="item" t-key="item.id"
                                                             t-att-class="plateClass(item, 'rack')"
                                                             t-att-style="plateStyle(item)">
                                                            <span class="o_pt_bin_badge" t-esc="binBadge(item)"/>
                                                            <span class="o_pt_heat" t-esc="item.heatNo"/>
                                                            <span class="o_pt_so" t-esc="item.soNumber"/>
                                                        </div>
                                                        <div t-if="!bin.items.length" class="o_pt_empty">Empty</div>
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="o_pt_temp_zone">
                                                <div class="o_pt_bin_head">
                                                    <span class="o_pt_bin_swatch o_pt_bin_swatch--temp"/>
                                                    <span class="o_pt_bin_name">Temporary Zone</span>
                                                    <span class="o_pt_bin_count"><t t-esc="temporaryCount"/> held</span>
                                                </div>
                                                <div class="o_pt_temp_rack">
                                                    <div t-foreach="temporaryItems" t-as="item" t-key="item.id"
                                                         t-att-class="plateClass(item, 'rack')"
                                                         t-on-click="() => this.selectItem(item)">
                                                        <span class="o_pt_bin_badge o_pt_bin_badge--temp">TEMP</span>
                                                        <span class="o_pt_heat" t-esc="item.heatNo"/>
                                                        <span class="o_pt_so" t-esc="item.soNumber"/>
                                                    </div>
                                                    <div t-if="!temporaryItems.length" class="o_pt_empty">No plates in temporary zone</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="o_pt_actions">
                                        <button type="button" class="o_pt_btn o_pt_btn--outline"
                                                t-att-disabled="state.busy" t-on-click="reset">Reset</button>
                                        <button type="button" class="o_pt_btn o_pt_btn--soft"
                                                t-att-disabled="state.busy or !selected or selected.status !== 'pending'"
                                                t-on-click="putToTemporary">
                                            <i class="fa fa-archive"/> Put to Temporary
                                        </button>
                                        <button type="button" class="o_pt_btn o_pt_btn--primary"
                                                t-att-disabled="state.busy or !selected or selected.status !== 'pending'"
                                                t-on-click="confirmPutAway">
                                            <i class="fa fa-arrows-v"/> Move to Allocated Bin
                                            <span t-if="selected and selected.status === 'pending'" class="o_pt_btn_badge" t-esc="selected.targetBin"/>
                                        </button>
                                    </div>
                                </section>
                            </div>

                            <aside class="o_pt_side">
                                <section class="o_pt_card o_pt_side_card">
                                    <h2 class="o_pt_card_title">Put Away Tasks</h2>
                                    <div class="o_pt_task_list">
                                        <div t-foreach="taskList" t-as="task" t-key="task.id"
                                             role="button" tabindex="0"
                                             t-att-class="taskClass(task)"
                                             t-att-style="task.style"
                                             t-on-click="() => this.selectItem(task)">
                                            <span class="o_pt_task_num" t-esc="task.index"/>
                                            <div class="o_pt_task_body">
                                                <div class="o_pt_task_title">
                                                    <strong t-esc="task.heatNo"/>
                                                    <span class="o_pt_bin_badge o_pt_bin_badge--inline" t-esc="binBadge(task)"/>
                                                </div>
                                                <div class="o_pt_task_meta">
                                                    <span>SO <t t-esc="task.soNumber"/></span>
                                                    <span t-esc="task.locationLabel"/>
                                                    <span t-attf-class="o_pt_task_status o_pt_task_status--{{task.status}}" t-esc="task.statusLabel"/>
                                                </div>
                                                <div class="o_pt_task_id" t-esc="task.id"/>
                                            </div>
                                        </div>
                                    </div>
                                </section>
                            </aside>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
